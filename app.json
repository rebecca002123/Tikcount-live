{
  "expo": {
    "name": "TokCount Live",
    "slug": "tokcount-live",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stylebestieai.tokcountlive",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.example.tokcountlive"
    },
    "extra": {
      "eas": {
        "projectId": "6f0d01ab-75a4-4b1b-8260-403b74b7273e"
      }
    },
    "owner": "style-bestie-ai",
    "plugins": [
      "expo-status-bar",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "TikCountWidget",
              "displayName": "TikCount Live",
              "description": "Track your exact TikTok views",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "./TikCountWidget.tsx"
              }
            }
          ]
        }
      ]
    ]
  }
}